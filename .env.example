# Zweep for Zabbix: settings of compose.yaml. Copy to .env and edit.
# Secrets do not belong here: they are files in ./secrets (see compose.yaml).

# Public address of Zweep as the phones and Zabbix reach it (comma-separated if more than one).
# It goes into the activation QR codes. Examples:
#   https://zweep.example.com              (reverse proxy or HTTPS on Zweep, port 443)
#   https://zweep.example.com:8080         (HTTPS configured on Zweep, Settings → HTTPS)
#   http://192.168.10.25:8080              (lab only: plain HTTP)
ZWEEP_SERVICE_URLS=https://zweep.example.com

# Reverse proxies whose X-Forwarded-For header is trusted (IPs or CIDRs, comma-separated).
# Empty when the phones reach Zweep directly. Manual, chapter 5.3.
ZWEEP_TRUSTED_PROXIES=

# Host ports: public listener (webhook, phones) and dashboard (always bound to 127.0.0.1)
ZWEEP_PUBLIC_PORT=8080
ZWEEP_ADMIN_PORT=8081

# Plain HTTP listener for Let's Encrypt HTTP-01 challenges and the redirect to HTTPS:
# ":8090" and uncomment the "80:8090" port in compose.yaml. Empty: disabled.
ZWEEP_LISTEN_PLAIN=

# Daily encrypted backup in ./backups: hour (local time, 0-23) and number of copies kept
ZWEEP_BACKUP_HOUR=1
ZWEEP_BACKUP_KEEP=14

# debug, info, warn or error
ZWEEP_LOG_LEVEL=info

# Time zone of logs and backup hour
TZ=Europe/Rome

# Image: GitHub Container Registry or the Docker Hub mirror (docker.io/n1k0droid/zweep:1.0.1)
ZWEEP_IMAGE=ghcr.io/n1k0droid/zweep:1.0.1
