<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP exists only for lab installations: the app refuses it unless the user confirmed
     the unencrypted connection for that server. User-installed CAs are trusted (company CA via MDM). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
